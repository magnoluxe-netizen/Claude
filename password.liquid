<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>

  {{ content_for_header }}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&display=swap');

    *{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;}
    body{
      background:#000;
      font-family:'Cinzel','Times New Roman',serif;
      overflow:hidden;
      color:#fff;
    }

    .pw-fondo{
      position:fixed;
      inset:0;
      z-index:0;
      background:#000;
    }
    .pw-fondo video{
      position:absolute;
      top:-1px;left:-1px;
      width:calc(100% + 2px);
      height:calc(100% + 2px);
      object-fit:cover;
      transition:filter .7s ease,opacity .7s ease;
    }
    .pw-fondo.desenfocado video{
      filter:blur(8px);
      opacity:.3;
    }

    .pw-contenedor{
      position:relative;
      z-index:2;
      height:100vh;
      height:100svh;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:clamp(18px,3vh,40px);
      padding:24px;
    }

    .pw-marca{
      text-align:center;
    }
    .pw-marca__nombre{
      font-size:clamp(24px,6vw,68px);
      font-weight:900;
      letter-spacing:.5em;
      text-transform:uppercase;
      line-height:1;
      color:#fff;
      text-indent:.5em;
    }
    .pw-marca__separador{
      width:100%;
      height:1px;
      background:#fff;
      margin-top:16px;
      opacity:.2;
    }

    .pw-aviso{
      font-size:clamp(7px,.85vw,9px);
      letter-spacing:.25em;
      text-transform:uppercase;
      color:rgba(255,255,255,.7);
      text-align:center;
      line-height:2;
      max-width:460px;
      text-indent:.25em;
    }

    .pw-cuenta{
      display:flex;
      gap:clamp(20px,5vw,56px);
      align-items:flex-start;
    }
    .pw-cuenta__bloque{
      display:flex;
      flex-direction:column;
      align-items:center;
    }
    .pw-cuenta__numero{
      font-size:clamp(40px,8vw,84px);
      font-weight:900;
      line-height:1;
      color:#fff;
      font-variant-numeric:tabular-nums;
      min-width:2ch;
      text-align:center;
    }
    .pw-cuenta__etiqueta{
      font-size:clamp(6px,.7vw,8px);
      letter-spacing:.3em;
      text-transform:uppercase;
      color:rgba(255,255,255,.3);
      margin-top:10px;
      text-indent:.3em;
    }

    .pw-acceso{
      position:relative;
      width:100%;
      max-width:340px;
      display:flex;
      flex-direction:column;
      align-items:center;
    }

    .pw-acceso__boton{
      background:#fff;
      color:#000;
      font-family:'Cinzel',serif;
      font-size:clamp(9px,1vw,12px);
      font-weight:700;
      letter-spacing:.6em;
      text-transform:uppercase;
      padding:clamp(18px,2.5vh,24px) 0;
      border:2px solid #fff;
      cursor:pointer;
      border-radius:0;
      transition:background .25s,color .25s;
      text-indent:.6em;
      user-select:none;
      width:100%;
      text-align:center;
    }
    .pw-acceso__boton:hover{
      background:transparent;
      color:#fff;
    }

    .pw-formulario{
      position:absolute;
      top:calc(100% + 20px);
      left:50%;
      transform:translateX(-50%);
      display:none;
      flex-direction:column;
      align-items:center;
      width:100%;
    }
    .pw-formulario.abierto{display:flex;}

    .pw-formulario__input{
      background:transparent;
      border:none;
      border-bottom:1px solid rgba(255,255,255,.4);
      color:#fff;
      font-family:'Cinzel',serif;
      font-size:13px;
      letter-spacing:.35em;
      padding:14px 4px;
      outline:none;
      width:100%;
      text-align:center;
      caret-color:#fff;
      -webkit-text-fill-color:#fff;
      border-radius:0;
    }
    .pw-formulario__input::placeholder{
      color:rgba(255,255,255,.2);
      letter-spacing:.5em;
      font-size:9px;
      text-indent:.5em;
    }

    .pw-formulario__boton{
      margin-top:20px;
      background:transparent;
      border:1px solid #fff;
      color:#fff;
      font-family:'Cinzel',serif;
      font-size:8px;
      font-weight:700;
      letter-spacing:.6em;
      text-transform:uppercase;
      padding:16px 0;
      cursor:pointer;
      width:100%;
      border-radius:0;
      transition:background .25s,color .25s;
      text-indent:.6em;
    }
    .pw-formulario__boton:hover{
      background:#fff;
      color:#000;
    }

    .pw-formulario__error{
      margin-top:14px;
      font-size:8px;
      letter-spacing:.5em;
      text-transform:uppercase;
      color:rgba(255,255,255,.35);
      text-align:center;
      text-indent:.5em;
    }

    .pw-video-escritorio{display:none;}
    .pw-video-movil{display:block;}

    @media(max-width:989px){
      body{position:fixed;inset:0;width:100%;}
    }

    @media(min-width:990px){
      .pw-video-escritorio{display:block;}
      .pw-video-movil{display:none;}
    }
  </style>
</head>

<body>

  {%- assign pw_src_escritorio = 'https://cdn.shopify.com/videos/c/o/v/5ecad132177f4c57a813671fbfe807c5.mp4' -%}
  {%- assign pw_src_movil = 'https://cdn.shopify.com/videos/c/o/v/5151d60bfbd04de1811b1fb2a986517a.mp4' -%}

  <div class="pw-fondo" id="pwFondo">
    <video class="pw-video-escritorio" autoplay muted loop playsinline>
      <source src="{{ pw_src_escritorio }}" type="video/mp4">
    </video>
    <video class="pw-video-movil" autoplay muted loop playsinline>
      <source src="{{ pw_src_movil }}" type="video/mp4">
    </video>
  </div>

  <main class="pw-contenedor">

    <div class="pw-marca">
      <h1 class="pw-marca__nombre">{{ shop.name }}</h1>
      <div class="pw-marca__separador"></div>
    </div>

    <p class="pw-aviso">Acceso VIP con clave — Compras en las primeras 24 horas tienen tarifas exclusivas. Sábado: apertura general a precio regular.</p>

    <div class="pw-cuenta">
      <div class="pw-cuenta__bloque">
        <span class="pw-cuenta__numero" id="pwDias">00</span>
        <span class="pw-cuenta__etiqueta">Días</span>
      </div>
      <div class="pw-cuenta__bloque">
        <span class="pw-cuenta__numero" id="pwHoras">00</span>
        <span class="pw-cuenta__etiqueta">Horas</span>
      </div>
      <div class="pw-cuenta__bloque">
        <span class="pw-cuenta__numero" id="pwMinutos">00</span>
        <span class="pw-cuenta__etiqueta">Min</span>
      </div>
      <div class="pw-cuenta__bloque">
        <span class="pw-cuenta__numero" id="pwSegundos">00</span>
        <span class="pw-cuenta__etiqueta">Seg</span>
      </div>
    </div>

    <div class="pw-acceso">
      <div class="pw-acceso__boton" id="pwToggle" role="button" tabindex="0">Acceso Exclusivo</div>

      <div class="pw-formulario" id="pwFormulario">
        {% form 'storefront_password' %}
          <input
            class="pw-formulario__input"
            id="pwInput"
            type="password"
            name="password"
            placeholder="Contraseña"
            autocomplete="current-password"
          >
          <button class="pw-formulario__boton" type="submit">Entrar</button>
          {% if form.errors %}
            <span id="pwHayError" hidden></span>
            <div class="pw-formulario__error">Contraseña incorrecta</div>
          {% endif %}
        {% endform %}
      </div>
    </div>

  </main>

  <script>
    (function(){
      var objetivo = new Date('2026-05-22T19:00:00-05:00').getTime();

      function pad(n){ return n < 10 ? '0' + n : '' + n; }

      function tick(){
        var diff = Math.max(0, objetivo - Date.now());
        document.getElementById('pwDias').textContent     = pad(Math.floor(diff / 86400000));
        document.getElementById('pwHoras').textContent    = pad(Math.floor((diff % 86400000) / 3600000));
        document.getElementById('pwMinutos').textContent  = pad(Math.floor((diff % 3600000) / 60000));
        document.getElementById('pwSegundos').textContent = pad(Math.floor((diff % 60000) / 1000));
      }

      tick();
      setInterval(tick, 1000);

      var fondo = document.getElementById('pwFondo');
      var toggle = document.getElementById('pwToggle');
      var formulario = document.getElementById('pwFormulario');

      formulario.addEventListener('click', function(e){ e.stopPropagation(); });

      toggle.addEventListener('click', function(e){
        if(e.detail && e.detail > 1) return;
        var abierto = formulario.classList.toggle('abierto');
        fondo.classList.toggle('desenfocado', abierto);
      });

      if(document.getElementById('pwHayError')){
        formulario.classList.add('abierto');
        fondo.classList.add('desenfocado');
      }
    })();
  </script>

  {{ content_for_layout }}

</body>
</html>
