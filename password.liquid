<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>

  {{ content_for_header }}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&display=swap');
    *{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;}
    body{
      background:#000;
      font-family:'Cinzel','Times New Roman',serif;
      overflow:hidden;
      color:#fff;
    }

    .pw-fondo{
      position:fixed;
      inset:0;
      z-index:0;
      background:#000;
    }
    .pw-fondo video{
      position:absolute;
      top:-1px;left:-1px;
      width:calc(100% + 2px);
      height:calc(100% + 2px);
      object-fit:cover;
      transition:filter .7s ease,opacity .7s ease;
    }
    .pw-fondo.desenfocado video{
      filter:blur(8px);
      opacity:.3;
    }

    .pw-contenedor{
      position:relative;
      z-index:2;
      height:100vh;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
    }

    .pw-marca{
      text-align:center;
      margin-bottom:96px;
    }
    .pw-marca__nombre{
      font-size:clamp(26px,6vw,64px);
      font-weight:900;
      letter-spacing:.5em;
      text-transform:uppercase;
      line-height:1;
      color:#fff;
      text-indent:.5em;
    }
    .pw-marca__separador{
      width:100%;
      height:1px;
      background:#fff;
      margin:22px 0;
      opacity:.2;
    }
    .pw-marca__subtitulo{
      font-size:clamp(7px,1vw,9px);
      letter-spacing:.7em;
      text-transform:uppercase;
      color:rgba(255,255,255,.3);
      text-indent:.7em;
    }

    .pw-acceso{
      position:relative;
      display:flex;
      flex-direction:column;
      align-items:center;
    }

    .pw-acceso__candado{
      cursor:pointer;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:16px;
      user-select:none;
    }
    .pw-acceso__candado svg{
      width:24px;height:24px;
      fill:#fff;
      transition:opacity .3s;
    }
    .pw-acceso__candado:hover svg{opacity:.4;}

    .pw-acceso__etiqueta{
      font-size:8px;
      letter-spacing:.8em;
      text-transform:uppercase;
      color:rgba(255,255,255,.3);
      text-indent:.8em;
    }

    .pw-formulario{
      position:absolute;
      top:calc(100% + 44px);
      left:50%;
      transform:translateX(-50%);
      display:none;
      flex-direction:column;
      align-items:center;
      width:280px;
    }
    .pw-formulario.abierto{display:flex;}

    .pw-formulario__input{
      background:transparent;
      border:none;
      border-bottom:1px solid rgba(255,255,255,.4);
      color:#fff;
      font-family:'Cinzel',serif;
      font-size:13px;
      letter-spacing:.35em;
      padding:14px 4px;
      outline:none;
      width:100%;
      text-align:center;
      caret-color:#fff;
      -webkit-text-fill-color:#fff;
      border-radius:0;
    }
    .pw-formulario__input::placeholder{
      color:rgba(255,255,255,.2);
      letter-spacing:.55em;
      font-size:9px;
      text-indent:.55em;
    }

    .pw-formulario__boton{
      margin-top:32px;
      background:transparent;
      border:1px solid #fff;
      color:#fff;
      font-family:'Cinzel',serif;
      font-size:8px;
      font-weight:700;
      letter-spacing:.7em;
      text-transform:uppercase;
      padding:18px 0;
      cursor:pointer;
      width:100%;
      border-radius:0;
      transition:background .25s,color .25s;
      text-indent:.7em;
    }
    .pw-formulario__boton:hover{
      background:#fff;
      color:#000;
    }

    .pw-formulario__error{
      margin-top:22px;
      font-size:8px;
      letter-spacing:.5em;
      text-transform:uppercase;
      color:rgba(255,255,255,.35);
      text-align:center;
      text-indent:.5em;
    }

    .pw-video-escritorio{display:none;}
    .pw-video-movil{display:block;}

    @media(max-width:989px){
      body{position:fixed;inset:0;width:100%;}
      .pw-contenedor{height:100svh;}
      .pw-marca{margin-bottom:64px;}
      .pw-formulario{width:240px;}
    }

    @media(min-width:990px){
      .pw-video-escritorio{display:block;}
      .pw-video-movil{display:none;}
    }
  </style>
</head>

<body>

  <div class="pw-fondo" id="pwFondo">
    <video class="pw-video-escritorio" autoplay muted loop playsinline>
      <source src="https://cdn.shopify.com/videos/c/o/v/5ecad132177f4c57a813671fbfe807c5.mp4" type="video/mp4">
    </video>
    <video class="pw-video-movil" autoplay muted loop playsinline>
      <source src="https://cdn.shopify.com/videos/c/o/v/5151d60bfbd04de1811b1fb2a986517a.mp4" type="video/mp4">
    </video>
  </div>

  <main class="pw-contenedor">

    <div class="pw-marca">
      <h1 class="pw-marca__nombre">{{ shop.name }}</h1>
      <div class="pw-marca__separador"></div>
      <p class="pw-marca__subtitulo">Acceso Exclusivo</p>
    </div>

    <div class="pw-acceso">
      <div class="pw-acceso__candado" id="pwToggle">
        <svg viewBox="0 0 24 24">
          <path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V7Zm7 12H7v-8h10v8Z"/>
        </svg>
        <span class="pw-acceso__etiqueta">Acceder</span>
      </div>

      <div class="pw-formulario" id="pwFormulario">
        {% form 'storefront_password' %}
          <input
            class="pw-formulario__input"
            id="pwInput"
            type="password"
            name="password"
            placeholder="Contraseña"
            autocomplete="current-password"
          >
          <button class="pw-formulario__boton" type="submit">Entrar</button>
          {% if form.errors %}
            <span id="pwHayError" hidden></span>
            <div class="pw-formulario__error">Contraseña incorrecta</div>
          {% endif %}
        {% endform %}
      </div>
    </div>

  </main>

  <script>
    (function(){
      var fondo = document.getElementById('pwFondo');
      var toggle = document.getElementById('pwToggle');
      var formulario = document.getElementById('pwFormulario');

      formulario.addEventListener('click', function(e){ e.stopPropagation(); });

      toggle.addEventListener('click', function(e){
        if(e.detail && e.detail > 1) return;
        var abierto = formulario.classList.toggle('abierto');
        fondo.classList.toggle('desenfocado', abierto);
      });

      if(document.getElementById('pwHayError')){
        formulario.classList.add('abierto');
        fondo.classList.add('desenfocado');
      }
    })();
  </script>

  {{ content_for_layout }}

</body>
</html>
