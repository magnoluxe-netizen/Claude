<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>

  {{ content_for_header }}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&display=swap');

    *{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;}
    body{
      background:#000;
      font-family:'Cinzel','Times New Roman',serif;
      overflow:hidden;
      color:#fff;
    }

    .pw-fondo{
      position:fixed;
      inset:0;
      z-index:0;
      background:#000;
    }
    .pw-fondo video{
      position:absolute;
      top:-1px;left:-1px;
      width:calc(100% + 2px);
      height:calc(100% + 2px);
      object-fit:cover;
      transition:filter .6s ease,opacity .6s ease;
    }
    .pw-fondo.desenfocado video{
      filter:blur(8px);
      opacity:.22;
    }

    .pw-header{
      position:fixed;
      top:0;left:0;right:0;
      z-index:10;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:22px 24px;
      font-size:clamp(7px,.75vw,9px);
      letter-spacing:.55em;
      text-transform:uppercase;
      color:rgba(255,255,255,.35);
      text-indent:.55em;
    }

    .pw-footer{
      position:fixed;
      bottom:0;left:0;right:0;
      z-index:10;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:22px 24px;
      font-size:clamp(6px,.65vw,8px);
      letter-spacing:.5em;
      text-transform:uppercase;
      color:rgba(255,255,255,.18);
      text-indent:.5em;
    }

    .pw-contenedor{
      position:relative;
      z-index:2;
      height:100vh;
      height:100svh;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      padding:80px 24px;
    }

    .pw-central{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:clamp(28px,4.5vh,52px);
      transition:opacity .4s ease,transform .4s ease;
    }
    .pw-central.saliendo{
      opacity:0;
      transform:scale(.97);
      pointer-events:none;
    }

    .pw-marca{
      text-align:center;
    }
    .pw-marca__nombre{
      font-size:clamp(28px,7vw,76px);
      font-weight:900;
      letter-spacing:.5em;
      text-transform:uppercase;
      line-height:1;
      color:#fff;
      text-indent:.5em;
    }
    .pw-marca__separador{
      width:100%;
      height:1px;
      background:#fff;
      margin-top:18px;
      opacity:.15;
    }

    .pw-cuenta{
      display:flex;
      align-items:flex-start;
      gap:clamp(10px,2.5vw,22px);
    }
    .pw-cuenta__bloque{
      display:flex;
      flex-direction:column;
      align-items:center;
    }
    .pw-cuenta__numero{
      font-size:clamp(42px,9vw,88px);
      font-weight:900;
      line-height:1;
      color:#fff;
      font-variant-numeric:tabular-nums;
      min-width:2ch;
      text-align:center;
    }
    .pw-cuenta__sep{
      font-size:clamp(36px,8vw,80px);
      font-weight:900;
      line-height:1;
      color:rgba(255,255,255,.72);
      align-self:flex-start;
      user-select:none;
    }
    .pw-cuenta__etiqueta{
      font-size:clamp(10px,1.2vw,12px);
      letter-spacing:.3em;
      text-transform:uppercase;
      color:rgba(255,255,255,.65);
      margin-top:10px;
      text-indent:.3em;
    }

    .pw-candado{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:14px;
      cursor:pointer;
      user-select:none;
    }
    .pw-candado svg{
      width:22px;height:22px;
      stroke:#fff;
      transition:opacity .3s;
    }
    .pw-candado:hover svg{opacity:.45;}
    .pw-candado__etiqueta{
      font-size:8px;
      letter-spacing:.4em;
      text-transform:uppercase;
      color:rgba(255,255,255,.3);
      text-indent:.4em;
    }

    .pw-acceso{
      position:absolute;
      inset:0;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:40px;
      padding:24px;
      opacity:0;
      pointer-events:none;
      transition:opacity .4s ease;
    }
    .pw-acceso.activo{
      opacity:1;
      pointer-events:auto;
    }

    .pw-acceso__volver{
      background:none;
      border:none;
      color:rgba(255,255,255,.28);
      font-family:'Cinzel',serif;
      font-size:8px;
      letter-spacing:.4em;
      text-transform:uppercase;
      cursor:pointer;
      padding:0;
      text-indent:.4em;
      transition:color .25s;
    }
    .pw-acceso__volver:hover{
      color:rgba(255,255,255,.65);
    }

    .pw-formulario{
      display:flex;
      flex-direction:column;
      align-items:center;
      width:min(300px,100%);
    }

    .pw-formulario__input{
      background:transparent;
      border:none;
      border-bottom:1px solid rgba(255,255,255,.38);
      color:#fff;
      font-family:'Cinzel',serif;
      font-size:13px;
      letter-spacing:.35em;
      padding:14px 4px;
      outline:none;
      width:100%;
      text-align:center;
      caret-color:#fff;
      -webkit-text-fill-color:#fff;
      border-radius:0;
    }
    .pw-formulario__input::placeholder{
      color:rgba(255,255,255,.2);
      letter-spacing:.5em;
      font-size:9px;
      text-indent:.5em;
    }

    .pw-formulario__boton{
      margin-top:28px;
      background:transparent;
      border:1px solid #fff;
      color:#fff;
      font-family:'Cinzel',serif;
      font-size:8px;
      font-weight:700;
      letter-spacing:.6em;
      text-transform:uppercase;
      padding:17px 0;
      cursor:pointer;
      width:100%;
      border-radius:0;
      transition:background .25s,color .25s;
      text-indent:.6em;
    }
    .pw-formulario__boton:hover{
      background:#fff;
      color:#000;
    }

    .pw-formulario__error{
      margin-top:16px;
      font-size:8px;
      letter-spacing:.5em;
      text-transform:uppercase;
      color:rgba(255,255,255,.35);
      text-align:center;
      text-indent:.5em;
    }

    .pw-video-escritorio{display:none;}
    .pw-video-movil{display:block;}

    @media(max-width:989px){
      body{position:fixed;inset:0;width:100%;}
    }

    @media(min-width:990px){
      .pw-video-escritorio{display:block;}
      .pw-video-movil{display:none;}
    }
  </style>
</head>

<body>

  {%- assign pw_src_escritorio = 'https://cdn.shopify.com/videos/c/o/v/5ecad132177f4c57a813671fbfe807c5.mp4' -%}
  {%- assign pw_src_movil = 'https://cdn.shopify.com/videos/c/o/v/5151d60bfbd04de1811b1fb2a986517a.mp4' -%}

  <div class="pw-fondo" id="pwFondo">
    <video class="pw-video-escritorio" autoplay muted loop playsinline>
      <source src="{{ pw_src_escritorio }}" type="video/mp4">
    </video>
    <video class="pw-video-movil" autoplay muted loop playsinline>
      <source src="{{ pw_src_movil }}" type="video/mp4">
    </video>
  </div>

  <header class="pw-header">Magnoluxe — Drop 01 // Mayo 22</header>

  <main class="pw-contenedor">

    <div class="pw-central" id="pwCentral">

      <div class="pw-marca">
        <h1 class="pw-marca__nombre">{{ shop.name }}</h1>
        <div class="pw-marca__separador"></div>
      </div>

      <div class="pw-cuenta">
        <div class="pw-cuenta__bloque">
          <span class="pw-cuenta__numero" id="pwDias">00</span>
          <span class="pw-cuenta__etiqueta">Días</span>
        </div>
        <span class="pw-cuenta__sep">:</span>
        <div class="pw-cuenta__bloque">
          <span class="pw-cuenta__numero" id="pwHoras">00</span>
          <span class="pw-cuenta__etiqueta">Horas</span>
        </div>
        <span class="pw-cuenta__sep">:</span>
        <div class="pw-cuenta__bloque">
          <span class="pw-cuenta__numero" id="pwMinutos">00</span>
          <span class="pw-cuenta__etiqueta">Min</span>
        </div>
        <span class="pw-cuenta__sep">:</span>
        <div class="pw-cuenta__bloque">
          <span class="pw-cuenta__numero" id="pwSegundos">00</span>
          <span class="pw-cuenta__etiqueta">Seg</span>
        </div>
      </div>

      <div class="pw-candado" id="pwToggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <rect x="5" y="11" width="14" height="10"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
        <span class="pw-candado__etiqueta">Acceso Exclusivo</span>
      </div>

    </div>

    <div class="pw-acceso" id="pwAcceso">

      <button class="pw-acceso__volver" id="pwVolver">← Volver</button>

      <div class="pw-formulario">
        {% form 'storefront_password' %}
          <input
            class="pw-formulario__input"
            id="pwInput"
            type="password"
            name="password"
            placeholder="Contraseña"
            autocomplete="current-password"
          >
          <button class="pw-formulario__boton" type="submit">Ingresar</button>
          {% if form.errors %}
            <span id="pwHayError" hidden></span>
            <div class="pw-formulario__error">Contraseña incorrecta</div>
          {% endif %}
        {% endform %}
      </div>

    </div>

  </main>

  <footer class="pw-footer">© Magnoluxe MMXXVI</footer>

  <script>
    (function(){
      var objetivo = new Date('2026-05-22T19:00:00-05:00').getTime();

      function pad(n){ return n < 10 ? '0' + n : '' + n; }

      function tick(){
        var diff = Math.max(0, objetivo - Date.now());
        document.getElementById('pwDias').textContent     = pad(Math.floor(diff / 86400000));
        document.getElementById('pwHoras').textContent    = pad(Math.floor((diff % 86400000) / 3600000));
        document.getElementById('pwMinutos').textContent  = pad(Math.floor((diff % 3600000) / 60000));
        document.getElementById('pwSegundos').textContent = pad(Math.floor((diff % 60000) / 1000));
      }

      tick();
      setInterval(tick, 1000);

      var fondo   = document.getElementById('pwFondo');
      var central = document.getElementById('pwCentral');
      var toggle  = document.getElementById('pwToggle');
      var acceso  = document.getElementById('pwAcceso');
      var volver  = document.getElementById('pwVolver');

      function abrirFormulario(){
        central.classList.add('saliendo');
        acceso.classList.add('activo');
        fondo.classList.add('desenfocado');
      }

      function cerrarFormulario(){
        central.classList.remove('saliendo');
        acceso.classList.remove('activo');
        fondo.classList.remove('desenfocado');
      }

      toggle.addEventListener('click', function(e){
        if(e.detail && e.detail > 1) return;
        abrirFormulario();
      });

      volver.addEventListener('click', cerrarFormulario);

      if(document.getElementById('pwHayError')){
        abrirFormulario();
      }
    })();
  </script>

  {{ content_for_layout }}

</body>
</html>
