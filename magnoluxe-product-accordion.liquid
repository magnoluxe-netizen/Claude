<section class="mglx-acord">
  <div class="mglx-acord__contenedor">

    <details class="mglx-acord__item">
      <summary class="mglx-acord__cabecera">
        <span class="mglx-acord__titulo">Guía de Tallas (Oversized)</span>
        <span class="mglx-acord__icono" aria-hidden="true"></span>
      </summary>
      <div class="mglx-acord__cuerpo">
        <p class="mglx-acord__texto">Nuestras prendas están cortadas bajo un patrón Oversized Fit de autor (silueta relajada y hombros caídos). Te recomendamos elegir tu talla habitual para el fit diseñado por la marca.</p>
        <table class="mglx-acord__tabla">
          <thead>
            <tr>
              <th class="mglx-acord__th">Talla</th>
              <th class="mglx-acord__th">Pecho</th>
              <th class="mglx-acord__th">Largo</th>
              <th class="mglx-acord__th">Manga</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="mglx-acord__td mglx-acord__td--talla">S</td>
              <td class="mglx-acord__td">58 cm</td>
              <td class="mglx-acord__td">70 cm</td>
              <td class="mglx-acord__td">22 cm</td>
            </tr>
            <tr>
              <td class="mglx-acord__td mglx-acord__td--talla">M</td>
              <td class="mglx-acord__td">61 cm</td>
              <td class="mglx-acord__td">73 cm</td>
              <td class="mglx-acord__td">23 cm</td>
            </tr>
            <tr>
              <td class="mglx-acord__td mglx-acord__td--talla">L</td>
              <td class="mglx-acord__td">64 cm</td>
              <td class="mglx-acord__td">76 cm</td>
              <td class="mglx-acord__td">24 cm</td>
            </tr>
            <tr>
              <td class="mglx-acord__td mglx-acord__td--talla">XL</td>
              <td class="mglx-acord__td">67 cm</td>
              <td class="mglx-acord__td">79 cm</td>
              <td class="mglx-acord__td">25 cm</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>

    <details class="mglx-acord__item">
      <summary class="mglx-acord__cabecera">
        <span class="mglx-acord__titulo">Envíos y Despachos</span>
        <span class="mglx-acord__icono" aria-hidden="true"></span>
      </summary>
      <div class="mglx-acord__cuerpo">
        <p class="mglx-acord__texto">Procesamos tus órdenes de forma inmediata. Los pedidos realizados antes de las 2:00 PM se entregan a la transportadora el mismo día hábil. Envíos nacionales seguros a través de Coordinadora o Servientrega desde Bucaramanga.</p>
        <div class="mglx-acord__envios">
          <div class="mglx-acord__envio-fila">
            <span class="mglx-acord__envio-zona">Santander y Área Metropolitana</span>
            <span class="mglx-acord__envio-tiempo">1 día hábil — Express</span>
          </div>
          <div class="mglx-acord__envio-fila">
            <span class="mglx-acord__envio-zona">Bogotá, Medellín, Cali</span>
            <span class="mglx-acord__envio-tiempo">1 a 3 días hábiles</span>
          </div>
          <div class="mglx-acord__envio-fila">
            <span class="mglx-acord__envio-zona">Resto de Colombia</span>
            <span class="mglx-acord__envio-tiempo">3 a 5 días hábiles</span>
          </div>
        </div>
      </div>
    </details>

  </div>
</section>

{% stylesheet %}
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&display=swap');

.mglx-acord{
  background:#fff;
  width:100%;
  padding:clamp(32px,5vh,64px) 0;
}

.mglx-acord__contenedor{
  max-width:1200px;
  margin:0 auto;
  padding:0 24px;
}

.mglx-acord__item{
  border-top:1.5px solid #000;
}

.mglx-acord__item:last-child{
  border-bottom:1.5px solid #000;
}

.mglx-acord__cabecera{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:clamp(16px,2.5vh,22px) 0;
  cursor:pointer;
  list-style:none;
  user-select:none;
}

.mglx-acord__cabecera::-webkit-details-marker{
  display:none;
}

.mglx-acord__titulo{
  font-family:'Cinzel','Times New Roman',serif;
  font-size:11px;
  font-weight:700;
  letter-spacing:.25em;
  text-transform:uppercase;
  color:#000;
  text-indent:.25em;
}

.mglx-acord__icono{
  position:relative;
  width:16px;
  height:16px;
  flex-shrink:0;
}

.mglx-acord__icono::before,
.mglx-acord__icono::after{
  content:'';
  position:absolute;
  background:#000;
  transition:transform .25s ease,opacity .25s ease;
}

.mglx-acord__icono::before{
  width:16px;
  height:1.5px;
  top:50%;
  left:0;
  transform:translateY(-50%);
}

.mglx-acord__icono::after{
  width:1.5px;
  height:16px;
  left:50%;
  top:0;
  transform:translateX(-50%);
}

details[open] .mglx-acord__icono::after{
  transform:translateX(-50%) scaleY(0);
  opacity:0;
}

.mglx-acord__cuerpo{
  display:flex;
  flex-direction:column;
  gap:clamp(20px,3vh,32px);
  padding-bottom:clamp(24px,3.5vh,40px);
}

.mglx-acord__texto{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(13px,1.1vw,15px);
  font-weight:500;
  line-height:1.85;
  color:#000;
  margin:0;
  max-width:680px;
}

.mglx-acord__tabla{
  width:100%;
  border-collapse:collapse;
}

.mglx-acord__th{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:9px;
  font-weight:800;
  letter-spacing:.3em;
  text-transform:uppercase;
  color:#000;
  text-align:left;
  padding:10px 16px 10px 0;
  border-bottom:1.5px solid #000;
  text-indent:.3em;
}

.mglx-acord__td{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(12px,1vw,14px);
  font-weight:600;
  letter-spacing:.08em;
  color:#000;
  padding:13px 16px 13px 0;
  border-bottom:1px solid rgba(0,0,0,.1);
}

.mglx-acord__td--talla{
  font-weight:800;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.mglx-acord__envios{
  display:flex;
  flex-direction:column;
}

.mglx-acord__envio-fila{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:16px;
  padding:13px 0;
  border-bottom:1px solid rgba(0,0,0,.1);
}

.mglx-acord__envio-fila:first-child{
  border-top:1px solid rgba(0,0,0,.1);
}

.mglx-acord__envio-zona{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(12px,1vw,14px);
  font-weight:600;
  letter-spacing:.06em;
  color:#000;
}

.mglx-acord__envio-tiempo{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(10px,.9vw,12px);
  font-weight:700;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:#000;
  text-align:right;
  flex-shrink:0;
}

@media(min-width:749px){
  .mglx-acord__contenedor{
    padding:0 clamp(32px,4vw,64px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "MGLX Product Accordion",
  "settings": [],
  "presets": [
    {
      "name": "MGLX Product Accordion"
    }
  ]
}
{% endschema %}
