{%- assign prod_a = section.settings.producto_a -%}
{%- assign prod_b = section.settings.producto_b -%}
{%- assign esquema = section.settings.color_scheme | default: 'dark' -%}

<section class="mglx-versus mglx-versus--{{ esquema }}">
  <div class="mglx-versus__contenedor">

    <div class="mglx-versus__panel mglx-versus__panel--izquierda">
      {% if prod_a %}
        <div class="mglx-versus__cabecera">
          {% if section.settings.etiqueta_a != blank %}
            <span class="mglx-versus__etiqueta">{{ section.settings.etiqueta_a }}</span>
          {% endif %}
          <div class="mglx-versus__titulo-fila">
            <h2 class="mglx-versus__titulo">{{ prod_a.title }}</h2>
            <span class="mglx-versus__precio">{{ prod_a.price | money }}</span>
          </div>
        </div>

        {% if prod_a.featured_image %}
          <div class="mglx-versus__zona-imagen">
            <img
              src="{{ prod_a.featured_image | image_url: width: 900 }}"
              srcset="{{ prod_a.featured_image | image_url: width: 450 }} 450w, {{ prod_a.featured_image | image_url: width: 900 }} 900w, {{ prod_a.featured_image | image_url: width: 1400 }} 1400w"
              sizes="(max-width:989px) 100vw, 50vw"
              width="{{ prod_a.featured_image.width }}"
              height="{{ prod_a.featured_image.height }}"
              alt="{{ prod_a.featured_image.alt | default: prod_a.title | escape }}"
              loading="lazy"
              class="mglx-versus__imagen"
            >
          </div>
        {% endif %}

        {% if section.settings.mistica_a != blank %}
          <div class="mglx-versus__bloque">
            <span class="mglx-versus__bloque-label">Mística</span>
            <p class="mglx-versus__mistica">{{ section.settings.mistica_a }}</p>
          </div>
        {% endif %}

        <div class="mglx-versus__specs">
          <div class="mglx-versus__spec-fila">
            <span class="mglx-versus__spec-label">Peso</span>
            <span class="mglx-versus__spec-valor">320 gramos // Algodón Premium de Alto Gramaje</span>
          </div>
          <div class="mglx-versus__spec-fila">
            <span class="mglx-versus__spec-label">Silueta</span>
            <span class="mglx-versus__spec-valor">Oversized Fit // Patrón de Autor</span>
          </div>
          <div class="mglx-versus__spec-fila">
            <span class="mglx-versus__spec-label">Detalles</span>
            <span class="mglx-versus__spec-valor">Cuello grueso, bordes afilados y acabados de alta costura</span>
          </div>
        </div>

        {% form 'product', prod_a %}
          {% unless prod_a.has_only_default_variant %}
            <div class="mglx-versus__tallas">
              {% for variant in prod_a.variants %}
                <label class="mglx-versus__talla{% unless variant.available %} mglx-versus__talla--agotada{% endunless %}">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    {% if forloop.first %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <span>{{ variant.title }}</span>
                </label>
              {% endfor %}
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ prod_a.variants.first.id }}">
          {% endunless %}
          <button type="submit" class="mglx-versus__boton-compra">
            {{ section.settings.boton_a | default: 'Adquirir Armadura' }}
          </button>
        {% endform %}

      {% else %}
        <div class="mglx-versus__vacio">
          <p class="mglx-versus__vacio-texto">Selecciona el Producto A en el editor</p>
        </div>
      {% endif %}
    </div>

    <div class="mglx-versus__panel mglx-versus__panel--derecha">
      {% if prod_b %}
        <div class="mglx-versus__cabecera">
          {% if section.settings.etiqueta_b != blank %}
            <span class="mglx-versus__etiqueta">{{ section.settings.etiqueta_b }}</span>
          {% endif %}
          <div class="mglx-versus__titulo-fila">
            <h2 class="mglx-versus__titulo">{{ prod_b.title }}</h2>
            <span class="mglx-versus__precio">{{ prod_b.price | money }}</span>
          </div>
        </div>

        {% if prod_b.featured_image %}
          <div class="mglx-versus__zona-imagen">
            <img
              src="{{ prod_b.featured_image | image_url: width: 900 }}"
              srcset="{{ prod_b.featured_image | image_url: width: 450 }} 450w, {{ prod_b.featured_image | image_url: width: 900 }} 900w, {{ prod_b.featured_image | image_url: width: 1400 }} 1400w"
              sizes="(max-width:989px) 100vw, 50vw"
              width="{{ prod_b.featured_image.width }}"
              height="{{ prod_b.featured_image.height }}"
              alt="{{ prod_b.featured_image.alt | default: prod_b.title | escape }}"
              loading="lazy"
              class="mglx-versus__imagen"
            >
          </div>
        {% endif %}

        {% if section.settings.mistica_b != blank %}
          <div class="mglx-versus__bloque">
            <span class="mglx-versus__bloque-label">Mística</span>
            <p class="mglx-versus__mistica">{{ section.settings.mistica_b }}</p>
          </div>
        {% endif %}

        <div class="mglx-versus__specs">
          <div class="mglx-versus__spec-fila">
            <span class="mglx-versus__spec-label">Peso</span>
            <span class="mglx-versus__spec-valor">320 gramos // Algodón Premium de Alto Gramaje</span>
          </div>
          <div class="mglx-versus__spec-fila">
            <span class="mglx-versus__spec-label">Silueta</span>
            <span class="mglx-versus__spec-valor">Oversized Fit // Patrón de Autor</span>
          </div>
          <div class="mglx-versus__spec-fila">
            <span class="mglx-versus__spec-label">Detalles</span>
            <span class="mglx-versus__spec-valor">Cuello grueso, bordes afilados y acabados de alta costura</span>
          </div>
        </div>

        {% form 'product', prod_b %}
          {% unless prod_b.has_only_default_variant %}
            <div class="mglx-versus__tallas">
              {% for variant in prod_b.variants %}
                <label class="mglx-versus__talla{% unless variant.available %} mglx-versus__talla--agotada{% endunless %}">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    {% if forloop.first %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <span>{{ variant.title }}</span>
                </label>
              {% endfor %}
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ prod_b.variants.first.id }}">
          {% endunless %}
          <button type="submit" class="mglx-versus__boton-compra">
            {{ section.settings.boton_b | default: 'Adquirir Armadura' }}
          </button>
        {% endform %}

      {% else %}
        <div class="mglx-versus__vacio">
          <p class="mglx-versus__vacio-texto">Selecciona el Producto B en el editor</p>
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&display=swap');

.mglx-versus--dark{
  --vs-fondo:#000;
  --vs-texto:#fff;
  --vs-divisor:rgba(255,255,255,.25);
  --vs-etiqueta:rgba(255,255,255,.38);
  --vs-precio:rgba(255,255,255,.55);
  --vs-mistica:rgba(255,255,255,.8);
  --vs-bloque-borde:rgba(255,255,255,.1);
  --vs-spec-label:rgba(255,255,255,.3);
  --vs-spec-valor:rgba(255,255,255,.55);
  --vs-talla-borde:rgba(255,255,255,.3);
  --vs-boton-hover-fondo:#fff;
  --vs-boton-hover-texto:#000;
  --vs-vacio:rgba(255,255,255,.05);
  --vs-placeholder:rgba(255,255,255,.2);
}

.mglx-versus--light{
  --vs-fondo:#f4f4f4;
  --vs-texto:#000;
  --vs-divisor:rgba(0,0,0,.18);
  --vs-etiqueta:rgba(0,0,0,.42);
  --vs-precio:rgba(0,0,0,.55);
  --vs-mistica:rgba(0,0,0,.78);
  --vs-bloque-borde:rgba(0,0,0,.1);
  --vs-spec-label:rgba(0,0,0,.35);
  --vs-spec-valor:rgba(0,0,0,.6);
  --vs-talla-borde:rgba(0,0,0,.28);
  --vs-boton-hover-fondo:#000;
  --vs-boton-hover-texto:#f4f4f4;
  --vs-vacio:rgba(0,0,0,.04);
  --vs-placeholder:rgba(0,0,0,.2);
}

.mglx-versus{
  background:var(--vs-fondo);
  width:100%;
}

.mglx-versus__contenedor{
  display:flex;
  flex-direction:column;
}

.mglx-versus__panel{
  flex:1;
  display:flex;
  flex-direction:column;
  gap:clamp(24px,4vh,48px);
  padding:clamp(40px,6vw,88px) clamp(28px,4vw,68px);
}

.mglx-versus__panel--izquierda{
  border-bottom:1px solid var(--vs-divisor);
}

.mglx-versus__cabecera{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.mglx-versus__etiqueta{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(8px,.85vw,10px);
  font-weight:400;
  letter-spacing:.3em;
  text-transform:uppercase;
  color:var(--vs-etiqueta);
  text-indent:.3em;
}

.mglx-versus__titulo-fila{
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  gap:16px;
}

.mglx-versus__titulo{
  font-family:'Cinzel','Times New Roman',serif;
  font-size:clamp(26px,4vw,52px);
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--vs-texto);
  line-height:1.05;
  margin:0;
}

.mglx-versus__precio{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(14px,1.4vw,18px);
  font-weight:300;
  letter-spacing:.05em;
  color:var(--vs-precio);
  white-space:nowrap;
  flex-shrink:0;
}

.mglx-versus__zona-imagen{
  aspect-ratio:2/3;
  overflow:hidden;
  background:var(--vs-vacio);
}

.mglx-versus__imagen{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.mglx-versus__bloque{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.mglx-versus__bloque-label{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:8px;
  font-weight:400;
  letter-spacing:.45em;
  text-transform:uppercase;
  color:var(--vs-spec-label);
  text-indent:.45em;
}

.mglx-versus__mistica{
  font-family:'Cinzel','Times New Roman',serif;
  font-size:clamp(13px,1.1vw,15px);
  font-weight:400;
  line-height:1.9;
  color:var(--vs-mistica);
  margin:0;
}

.mglx-versus__specs{
  display:flex;
  flex-direction:column;
}

.mglx-versus__spec-fila{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:16px;
  padding:12px 0;
  border-bottom:1px solid var(--vs-bloque-borde);
}

.mglx-versus__spec-fila:first-child{
  border-top:1px solid var(--vs-bloque-borde);
}

.mglx-versus__spec-label{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:8px;
  font-weight:400;
  letter-spacing:.4em;
  text-transform:uppercase;
  color:var(--vs-spec-label);
  text-indent:.4em;
  flex-shrink:0;
}

.mglx-versus__spec-valor{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(9px,.88vw,11px);
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--vs-spec-valor);
  text-align:right;
}

.mglx-versus__tallas{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

.mglx-versus__talla{
  cursor:pointer;
}

.mglx-versus__talla input[type="radio"]{
  position:absolute;
  appearance:none;
  opacity:0;
  width:0;
  height:0;
  pointer-events:none;
}

.mglx-versus__talla span{
  display:block;
  padding:10px 18px;
  border:1px solid var(--vs-talla-borde);
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:11px;
  font-weight:600;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--vs-texto);
  cursor:pointer;
  transition:background .12s,color .12s,border-color .12s;
  text-indent:.2em;
  user-select:none;
}

.mglx-versus__talla input[type="radio"]:checked + span{
  background:var(--vs-texto);
  color:var(--vs-fondo);
  border-color:var(--vs-texto);
}

.mglx-versus__talla--agotada span{
  opacity:.25;
  cursor:not-allowed;
  text-decoration:line-through;
}

.mglx-versus__boton-compra{
  width:100%;
  background:transparent;
  border:1px solid var(--vs-texto);
  color:var(--vs-texto);
  font-family:'Cinzel','Times New Roman',serif;
  font-size:clamp(9px,.9vw,11px);
  font-weight:700;
  letter-spacing:.5em;
  text-transform:uppercase;
  padding:clamp(16px,2vh,22px) 0;
  cursor:pointer;
  border-radius:0;
  transition:background .12s,color .12s;
  text-indent:.5em;
}

.mglx-versus__boton-compra:hover{
  background:var(--vs-boton-hover-fondo);
  color:var(--vs-boton-hover-texto);
}

.mglx-versus__vacio{
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:400px;
  border:1px dashed var(--vs-talla-borde);
}

.mglx-versus__vacio-texto{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:11px;
  letter-spacing:.25em;
  text-transform:uppercase;
  color:var(--vs-placeholder);
  text-align:center;
  text-indent:.25em;
}

@media(min-width:990px){
  .mglx-versus__contenedor{
    flex-direction:row;
    min-height:100svh;
  }
  .mglx-versus__panel--izquierda{
    border-bottom:none;
    border-right:1px solid var(--vs-divisor);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Versus — Drop",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de Color",
      "options": [
        {"value": "dark", "label": "Oscuro Brutalista"},
        {"value": "light", "label": "Editorial Claro"}
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Producto A — Izquierda"
    },
    {
      "type": "product",
      "id": "producto_a",
      "label": "Producto A"
    },
    {
      "type": "text",
      "id": "etiqueta_a",
      "label": "Etiqueta",
      "default": "ARCHETYPO 01"
    },
    {
      "type": "textarea",
      "id": "mistica_a",
      "label": "Mística / Historia",
      "default": "Construida para quienes entienden que la ropa no es decoración sino declaración. Cada costura es una cicatriz deliberada."
    },
    {
      "type": "text",
      "id": "boton_a",
      "label": "Texto del Botón",
      "default": "Adquirir Armadura"
    },
    {
      "type": "header",
      "content": "Producto B — Derecha"
    },
    {
      "type": "product",
      "id": "producto_b",
      "label": "Producto B"
    },
    {
      "type": "text",
      "id": "etiqueta_b",
      "label": "Etiqueta",
      "default": "ARCHETYPO 02"
    },
    {
      "type": "textarea",
      "id": "mistica_b",
      "label": "Mística / Historia",
      "default": "Para los que guardan silencio pero hablan con presencia. Un corte que convierte el cuerpo en santuario."
    },
    {
      "type": "text",
      "id": "boton_b",
      "label": "Texto del Botón",
      "default": "Adquirir Armadura"
    }
  ],
  "presets": [
    {
      "name": "Versus — Drop"
    }
  ]
}
{% endschema %}
