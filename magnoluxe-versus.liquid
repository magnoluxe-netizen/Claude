{%- assign prod_a = section.settings.producto_a -%}
{%- assign prod_b = section.settings.producto_b -%}

<section class="mglx-versus">
  <div class="mglx-versus__contenedor">

    <div class="mglx-versus__panel mglx-versus__panel--izquierda">
      <div class="mglx-versus__cabecera">
        {% if section.settings.etiqueta_izquierda != blank %}
          <span class="mglx-versus__etiqueta">{{ section.settings.etiqueta_izquierda }}</span>
        {% endif %}
        {% if prod_a %}
          <h2 class="mglx-versus__titulo">{{ prod_a.title }}</h2>
        {% endif %}
      </div>

      <div class="mglx-versus__zona-imagen{% if section.settings.imagen_izquierda == blank %} mglx-versus__zona-imagen--vacia{% endif %}">
        {% if section.settings.imagen_izquierda != blank %}
          <img
            src="{{ section.settings.imagen_izquierda | image_url: width: 900 }}"
            srcset="{{ section.settings.imagen_izquierda | image_url: width: 450 }} 450w, {{ section.settings.imagen_izquierda | image_url: width: 900 }} 900w, {{ section.settings.imagen_izquierda | image_url: width: 1400 }} 1400w"
            sizes="(max-width:989px) 100vw, 50vw"
            width="{{ section.settings.imagen_izquierda.width }}"
            height="{{ section.settings.imagen_izquierda.height }}"
            alt="{{ section.settings.imagen_izquierda.alt | default: section.settings.etiqueta_izquierda | escape }}"
            loading="lazy"
            class="mglx-versus__imagen"
          >
        {% endif %}
      </div>

      <div class="mglx-versus__cuerpo">
        {% if section.settings.mistica_izquierda != blank %}
          <div class="mglx-versus__bloque">
            <span class="mglx-versus__bloque-label">Mística</span>
            <p class="mglx-versus__mistica">{{ section.settings.mistica_izquierda }}</p>
          </div>
        {% endif %}

        <div class="mglx-versus__bloque">
          <span class="mglx-versus__bloque-label">Especificaciones</span>
          <div class="mglx-versus__specs">
            <div class="mglx-versus__spec-fila">
              <span class="mglx-versus__spec-label">Peso</span>
              <span class="mglx-versus__spec-valor">320 gramos // Algodón Premium de Alto Gramaje</span>
            </div>
            <div class="mglx-versus__spec-fila">
              <span class="mglx-versus__spec-label">Silueta</span>
              <span class="mglx-versus__spec-valor">Oversized Fit // Patrón de Autor</span>
            </div>
            <div class="mglx-versus__spec-fila">
              <span class="mglx-versus__spec-label">Confección</span>
              <span class="mglx-versus__spec-valor">Cuello grueso anti-deformación y bordes de alta costura</span>
            </div>
          </div>
        </div>

        <a
          class="mglx-versus__boton"
          href="{% if prod_a %}{{ prod_a.url }}{% else %}#{% endif %}"
        >{{ section.settings.boton_texto_izquierda | default: 'Elegir Armadura' }}</a>
      </div>
    </div>

    <div class="mglx-versus__panel mglx-versus__panel--derecha">
      <div class="mglx-versus__cabecera">
        {% if section.settings.etiqueta_derecha != blank %}
          <span class="mglx-versus__etiqueta">{{ section.settings.etiqueta_derecha }}</span>
        {% endif %}
        {% if prod_b %}
          <h2 class="mglx-versus__titulo">{{ prod_b.title }}</h2>
        {% endif %}
      </div>

      <div class="mglx-versus__zona-imagen{% if section.settings.imagen_derecha == blank %} mglx-versus__zona-imagen--vacia{% endif %}">
        {% if section.settings.imagen_derecha != blank %}
          <img
            src="{{ section.settings.imagen_derecha | image_url: width: 900 }}"
            srcset="{{ section.settings.imagen_derecha | image_url: width: 450 }} 450w, {{ section.settings.imagen_derecha | image_url: width: 900 }} 900w, {{ section.settings.imagen_derecha | image_url: width: 1400 }} 1400w"
            sizes="(max-width:989px) 100vw, 50vw"
            width="{{ section.settings.imagen_derecha.width }}"
            height="{{ section.settings.imagen_derecha.height }}"
            alt="{{ section.settings.imagen_derecha.alt | default: section.settings.etiqueta_derecha | escape }}"
            loading="lazy"
            class="mglx-versus__imagen"
          >
        {% endif %}
      </div>

      <div class="mglx-versus__cuerpo">
        {% if section.settings.mistica_derecha != blank %}
          <div class="mglx-versus__bloque">
            <span class="mglx-versus__bloque-label">Mística</span>
            <p class="mglx-versus__mistica">{{ section.settings.mistica_derecha }}</p>
          </div>
        {% endif %}

        <div class="mglx-versus__bloque">
          <span class="mglx-versus__bloque-label">Especificaciones</span>
          <div class="mglx-versus__specs">
            <div class="mglx-versus__spec-fila">
              <span class="mglx-versus__spec-label">Peso</span>
              <span class="mglx-versus__spec-valor">320 gramos // Algodón Premium de Alto Gramaje</span>
            </div>
            <div class="mglx-versus__spec-fila">
              <span class="mglx-versus__spec-label">Silueta</span>
              <span class="mglx-versus__spec-valor">Oversized Fit // Patrón de Autor</span>
            </div>
            <div class="mglx-versus__spec-fila">
              <span class="mglx-versus__spec-label">Confección</span>
              <span class="mglx-versus__spec-valor">Cuello grueso anti-deformación y bordes de alta costura</span>
            </div>
          </div>
        </div>

        <a
          class="mglx-versus__boton"
          href="{% if prod_b %}{{ prod_b.url }}{% else %}#{% endif %}"
        >{{ section.settings.boton_texto_derecha | default: 'Elegir Armadura' }}</a>
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&display=swap');

.mglx-versus{
  background:#f4f4f4;
  width:100%;
}

.mglx-versus__contenedor{
  display:flex;
  flex-direction:column;
}

.mglx-versus__panel{
  flex:1;
  display:flex;
  flex-direction:column;
  gap:clamp(28px,4.5vh,52px);
  padding:clamp(40px,6vw,88px) clamp(28px,4vw,68px);
}

.mglx-versus__panel--izquierda{
  border-bottom:1px solid rgba(0,0,0,.15);
}

.mglx-versus__cabecera{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.mglx-versus__etiqueta{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(8px,.85vw,10px);
  font-weight:400;
  letter-spacing:.3em;
  text-transform:uppercase;
  color:rgba(0,0,0,.4);
  text-indent:.3em;
}

.mglx-versus__titulo{
  font-family:'Cinzel','Times New Roman',serif;
  font-size:clamp(30px,4.5vw,58px);
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#000;
  line-height:1.05;
  margin:0;
}

.mglx-versus__zona-imagen{
  aspect-ratio:2/3;
  overflow:hidden;
  background:#e8e8e8;
}

.mglx-versus__zona-imagen--vacia{
  background:#ebebeb;
}

.mglx-versus__imagen{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.mglx-versus__cuerpo{
  display:flex;
  flex-direction:column;
  gap:0;
}

.mglx-versus__bloque{
  display:flex;
  flex-direction:column;
  gap:12px;
  padding:clamp(20px,3vh,32px) 0;
  border-top:1px solid rgba(0,0,0,.1);
}

.mglx-versus__bloque:first-child{
  border-top:none;
  padding-top:0;
}

.mglx-versus__bloque-label{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:8px;
  font-weight:400;
  letter-spacing:.45em;
  text-transform:uppercase;
  color:rgba(0,0,0,.32);
  text-indent:.45em;
}

.mglx-versus__mistica{
  font-family:'Cinzel','Times New Roman',serif;
  font-size:clamp(13px,1.15vw,15px);
  font-weight:400;
  line-height:1.9;
  color:rgba(0,0,0,.82);
  margin:0;
}

.mglx-versus__specs{
  display:flex;
  flex-direction:column;
}

.mglx-versus__spec-fila{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:16px;
  padding:10px 0;
  border-bottom:1px solid rgba(0,0,0,.08);
}

.mglx-versus__spec-fila:first-child{
  border-top:1px solid rgba(0,0,0,.08);
}

.mglx-versus__spec-label{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:8px;
  font-weight:400;
  letter-spacing:.4em;
  text-transform:uppercase;
  color:rgba(0,0,0,.35);
  text-indent:.4em;
  flex-shrink:0;
}

.mglx-versus__spec-valor{
  font-family:system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
  font-size:clamp(9px,.88vw,11px);
  letter-spacing:.12em;
  text-transform:uppercase;
  color:rgba(0,0,0,.55);
  text-align:right;
}

.mglx-versus__boton{
  display:inline-block;
  font-family:'Cinzel','Times New Roman',serif;
  font-size:clamp(8px,.85vw,10px);
  font-weight:700;
  letter-spacing:.5em;
  text-transform:uppercase;
  color:#fff;
  background:#000;
  border:1px solid #000;
  padding:clamp(14px,1.8vh,18px) clamp(24px,3vw,44px);
  text-decoration:none;
  text-indent:.5em;
  border-radius:0;
  transition:background .12s,color .12s;
  margin-top:clamp(8px,1.5vh,16px);
  align-self:flex-start;
}

.mglx-versus__boton:hover{
  background:transparent;
  color:#000;
}

@media(min-width:990px){
  .mglx-versus__contenedor{
    flex-direction:row;
    min-height:100svh;
  }
  .mglx-versus__panel--izquierda{
    border-bottom:none;
    border-right:1px solid rgba(0,0,0,.15);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Versus — Comparativa",
  "settings": [
    {
      "type": "header",
      "content": "Lado Izquierdo"
    },
    {
      "type": "product",
      "id": "producto_a",
      "label": "Producto A (título y enlace dinámicos)"
    },
    {
      "type": "text",
      "id": "etiqueta_izquierda",
      "label": "Etiqueta",
      "default": "ARCHETYPO 01"
    },
    {
      "type": "image_picker",
      "id": "imagen_izquierda",
      "label": "Imagen"
    },
    {
      "type": "textarea",
      "id": "mistica_izquierda",
      "label": "Mística / Significado",
      "default": "Construida para quienes entienden que la ropa no es decoración sino declaración. Cada costura es una cicatriz deliberada."
    },
    {
      "type": "text",
      "id": "boton_texto_izquierda",
      "label": "Texto del Botón",
      "default": "Elegir Armadura"
    },
    {
      "type": "header",
      "content": "Lado Derecho"
    },
    {
      "type": "product",
      "id": "producto_b",
      "label": "Producto B (título y enlace dinámicos)"
    },
    {
      "type": "text",
      "id": "etiqueta_derecha",
      "label": "Etiqueta",
      "default": "ARCHETYPO 02"
    },
    {
      "type": "image_picker",
      "id": "imagen_derecha",
      "label": "Imagen"
    },
    {
      "type": "textarea",
      "id": "mistica_derecha",
      "label": "Mística / Significado",
      "default": "Para los que guardan silencio pero hablan con presencia. Un corte que convierte el cuerpo en santuario."
    },
    {
      "type": "text",
      "id": "boton_texto_derecha",
      "label": "Texto del Botón",
      "default": "Elegir Armadura"
    }
  ],
  "presets": [
    {
      "name": "Versus — Comparativa"
    }
  ]
}
{% endschema %}
